# =====================================================================
# ClassMate AI 后端环境变量模板
# 用法：复制为 backend/.env 后填写真实值
# =====================================================================

api_key=sk-your-siliconflow-key
base_url=https://api.siliconflow.cn/v1
model_name=Qwen/Qwen3-VL-32B-Instruct
embedding_model=Qwen/Qwen3-Embedding-8B

temperature=0.3
max_tokens=4096
# 单次模型调用超时（秒）。整份课件 JSON 较大，建议 240~300
request_timeout=300

# 可选：关闭真实模型，走确定性演示逻辑（便于离线答辩）
use_llm=true

# 本地向量检索开关（默认开启）：embedding 存 SQLite，numpy 余弦相似度暴力检索，
# 不依赖 chromadb 二进制；embedding 服务不可用时自动降级为关键词匹配，功能不缺失。
enable_vector=true

# 服务
host=0.0.0.0
port=8001
